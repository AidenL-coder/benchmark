                 target_folder = build_dir / repo
+                # cbs D-43 fix: copytree(dirs_exist_ok=True) fails on any
+                # leftover staging from an earlier run, because git writes
+                # .git/objects/* read-only (mode 444) and copytree cannot
+                # overwrite them. The harness reports the resulting
+                # exception identically to a genuine model failure, so this
+                # silently corrupts a run's denominator rather than failing
+                # loudly. Staging is regenerable build context, never
+                # source, so clearing it is safe.
+                if target_folder.exists():
+                    def _force_writable(func, path, exc_info):
+                        import os, stat
+                        os.chmod(path, stat.S_IWRITE | stat.S_IREAD)
+                        func(path)
+                    shutil.rmtree(target_folder, onerror=_force_writable)
                 shutil.copytree(local_folder, target_folder, dirs_exist_ok=True)
                 logger.info(f"Copied folder {local_folder} to {target_folder}")
 
