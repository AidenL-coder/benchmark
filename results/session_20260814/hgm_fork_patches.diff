+# --- cbs D-48: explicit prompt budgets -------------------------------------
+# See module history: upstream's own code_text clip is commented out below
+# and md_log is unbounded, which cannot fit a self-hosted 32k context.
+_CBS_CODE_BUDGET = 24000
+_CBS_MDLOG_BUDGET = 32000
+_CBS_EVALLOG_BUDGET = 8000
+
+
+def _cbs_clip_middle(text, limit, label):
+    """Clip to `limit` chars, keeping head and tail and marking the cut.
+
+    Head and tail are both kept on purpose: the start of a trajectory says
+    what the agent set out to do, the end says how it failed. Keeping only
+    one end discards half the diagnostic signal.
+    """
+    if text is None or len(text) <= limit:
+        return text
+    head = limit // 2
+    tail = limit - head
+    return (
+        text[:head]
+        + f"\n\n<{label} clipped: {len(text) - limit} of {len(text)} chars "
+        f"omitted to fit the served context window>\n\n"
+        + text[-tail:]
+    )
+
+
 def get_eval_log_text(eval_json, test_status=None):
     if not test_status:
         first_key = next(iter(eval_json))
